{
  "id": "EUVD-2026-107565",
  "enisaUuid": "041475e3-b98d-3f0e-a991-33f65af3ab27",
  "description": "The system certificate authority (CA) store in Red Hat products, distributed via ca-certificates RPM packages, included multiple root CA certificates of authorities, which signed intermediate CA certificates with weak private keys issued by the eMudhra certificate authority. A man-in-the-middle attacker could use this flaw to issue certificates for arbitrary host names signed by the weak intermediate CA certificates, which would be considered trusted by a TLS/SSL client using system CA store and cause such clients to connect to malicious sites.\n\nDue to inability to only distrust specific intermediate certificates in all clients using the system CA store, root CA certificates of authorities that signed weak intermediate CA certificates are being removed.",
  "datePublished": "Oct 21, 2026, 8:56:26 PM",
  "dateUpdated": "Oct 29, 2026, 7:53:39 PM",
  "baseScore": 6.8,
  "baseScoreVersion": "3.1",
